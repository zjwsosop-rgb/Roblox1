local function createMinFloat(pos)
	if floatFrame then floatFrame:Destroy(); floatFrame = nil end
	if floatRainbowThread then task.cancel(floatRainbowThread); floatRainbowThread = nil end

	local ball = Instance.new("Frame")
	ball.Size = UDim2.new(0, 50, 0, 50)
	ball.Position = pos or UDim2.new(0.1, 0, 0.1, 0)
	ball.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
	ball.ZIndex = 10000
	ball.Parent = ScreenGui
	local bCorner = Instance.new("UICorner"); bCorner.CornerRadius = UDim.new(1, 0); bCorner.Parent = ball
	
	local bStroke = Instance.new("UIStroke"); bStroke.Color = Color3.fromRGB(0, 0, 0); bStroke.Thickness = 2; bStroke.Parent = ball
	local tText = Instance.new("TextLabel"); tText.Size = UDim2.new(1,0,0.6,0); tText.Position = UDim2.new(0,0,0,2); tText.BackgroundTransparency = 1; tText.Text = "tox"; tText.TextColor3 = Color3.fromRGB(255,255,255); tText.Font = Enum.Font.GothamBlack; tText.TextScaled = true; tText.Parent = ball
	local wText = Instance.new("TextLabel"); wText.Size = UDim2.new(1,0,0.2,0); wText.Position = UDim2.new(0,0,0.65,0); wText.BackgroundTransparency = 1; wText.Text = "小路TVT"; wText.TextColor3 = Color3.fromRGB(180, 180, 180); wText.Font = Enum.Font.GothamBold; wText.TextSize = 6; wText.Parent = ball

	local isTouching = false
	local isClickAction = false
	local touchStartPos = nil
	local frameStartPos = nil

	ball.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			isTouching = true
			isClickAction = true
			touchStartPos = Vector2.new(input.Position.X, input.Position.Y)
			frameStartPos = Vector2.new(ball.Position.X.Offset, ball.Position.Y.Offset)
		end
	end)

	ball.InputChanged:Connect(function(input)
		if isTouching and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local dx = input.Position.X - touchStartPos.X
			local dy = input.Position.Y - touchStartPos.Y
			if (dx*dx + dy*dy) > 144 then
				isClickAction = false 
			end
			ball.Position = UDim2.new(0, frameStartPos.X + dx, 0, frameStartPos.Y + dy)
		end
	end)

	ball.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			isTouching = false
			if isClickAction then
				if floatRainbowThread then task.cancel(floatRainbowThread); floatRainbowThread = nil end
				local restorePos = ball.Position
				ball:Destroy()
				floatFrame = nil
				
				MainFrame.Position = restorePos
				MainFrame.Visible = true
				isMin = false
			end
		end
	end)

	floatFrame = ball
	return ball
end

MinBtn.MouseButton1Click:Connect(function()
	if isMin then return end
	isMin = true
	local currentPos = MainFrame.Position
