local function watchPlayer(player)
	task.wait(0.15)
	local function watchObj(root, plr)
		root.DescendantAdded:Connect(function(inst)
			if inst:IsA("Sound") then
				local id = tonumber(string.match(inst.SoundId, "rbxassetid://(%d+)"))
				if id then addLogEntry(plr, id) end
			end
		end)
	end
	if player.Character then watchObj(player.Character, player) end
	player.CharacterAdded:Connect(function(c) watchObj(c, player) end)
	watchObj(player.PlayerGui, player)
end

for _, plr in ipairs(Players:GetPlayers()) do task.spawn(watchPlayer, plr) end
Players.PlayerAdded:Connect(watchPlayer)