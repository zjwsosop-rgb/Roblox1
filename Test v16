	local function RunMusicTimeLoop()
		while wait(0.15) do  
			pcall(function()
				if Sound.TimeLength > 0 then
					local ratio = Sound.TimePosition / Sound.TimeLength
					mProgFill.Size = UDim2.new(math_clamp(ratio, 0, 1), 0, 1, 0)
					mTimeLabel.Text = string.format("%02d:%02d", math.floor(Sound.TimePosition/60), math.floor(Sound.TimePosition%60)) 
						.. "/" .. string.format("%02d:%02d", math.floor(Sound.TimeLength/60), math.floor(Sound.TimeLength%60))

					if #currentLyrics > 0 then
						local playTime = Sound.TimePosition
						local currentRaw = ""
						local currentTrans = ""
						local nextText = ""
						
						for i = 1, #currentLyrics do
							if currentLyrics[i].time <= playTime then
								currentRaw = currentLyrics[i].text
								currentTrans = currentLyrics[i].translation or ""
								if currentLyrics[i+1] then
									nextText = currentLyrics[i+1].text
								else
									nextText = "🎶 (Track ends)"
								end
							else
								break
							end
						end
						
						if (currentRaw == "") and currentLyrics[1] then
							currentRaw = "🎵 " .. (MusicPlaylist[MusicCurrentIndex] and MusicPlaylist[MusicCurrentIndex].title or "Listening to melody")
							currentTrans = "Artist: " .. (MusicPlaylist[MusicCurrentIndex] and MusicPlaylist[MusicCurrentIndex].artist or "Unknown")
							nextText = currentLyrics[1].text
						end

						if currentTrans ~= "" then
							lyricLabel1.Text = currentRaw
							lyricLabel2.Text = currentTrans
							lyricLabel2.TextColor3 = Theme.Accent
						else
							lyricLabel1.Text = currentRaw
							lyricLabel2.Text = nextText
							lyricLabel2.TextColor3 = Theme.TextMuted
						end
					end
				else
					mProgFill.Size = UDim2.new(0, 0, 1, 0)
					if Sound.IsPlaying then
						mTimeLabel.Text = "Buffering..."
					else
						mTimeLabel.Text = "00:00/00:00"
					end
				end
			end)
		end
	end
	coroutine.wrap(RunMusicTimeLoop)()

	local lastRestartTime = 0

	local function HandleMusicEnded()
		if os.clock() - lastRestartTime < 1 then return end
		lastRestartTime = os.clock()

		if MusicSingleLoop then
			Sound.TimePosition = 0
			Sound:Play()
			btnPlay.Text = "⏸"
		else
			if MusicCurrentIndex >= #MusicPlaylist then
				pcall(function() playTrackByIndex(1) end)
			else
				pcall(function() playTrackByIndex(MusicCurrentIndex + 1) end)
			end
		end
	end

