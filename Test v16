	local function httpRequest(url, method, headers, body)
		local req = (fluxus and fluxus.request) or (syn and syn.request) or request or http_request
		local fakeIP = getRandomMainlandIP()
		local finalHeaders = {
			["User-Agent"] = "Mozilla/5.0 (iPhone; CPU iPhone OS 15_0 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/15.0 Mobile/15E148 Safari/604.1",
			["Accept"] = "*/*",
			["X-Forwarded-For"] = fakeIP, 
			["X-Real-IP"] = fakeIP,        
			["True-Client-IP"] = fakeIP,   
			["Client-IP"] = fakeIP
		}
		if headers then
			for k, v in pairs(headers) do finalHeaders[k] = v end
		end
		if req then
			local res = req({
				Url = url,
				Method = method or "GET",
				Headers = finalHeaders,
				Body = body
			})
			return res and res.Body
		else
			if method == "POST" then
				local success, result = pcall(function() return game:HttpPost(url, body or "") end)
				return success and result or nil
			else
				local success, result = pcall(function() return game:HttpGet(url) end)
				return success and result or nil
			end
		end
	end

