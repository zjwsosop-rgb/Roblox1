local function ApplyESPToCharacter(player, character)
	if player == localPlayer or not character then return end
	
	local oldGlow = EspContainer:FindFirstChild("Glow_" .. player.Name)
	local oldTag = EspContainer:FindFirstChild("Tag_" .. player.Name)
	if oldGlow then oldGlow:Destroy() end
	if oldTag then oldTag:Destroy() end
	
	local root = character:WaitForChild("HumanoidRootPart", 5)
	if root then
		local dynamicColor = GetPlayerTeamColor(player)
		
		local glow = Instance_new("Highlight")
		glow.Name = "Glow_" .. player.Name
		glow.FillColor = dynamicColor
		glow.FillTransparency = 0.55
		glow.OutlineColor = Color3.fromRGB(255, 255, 255)
		glow.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		glow.Adornee = character
		glow.Enabled = false
		glow.Parent = EspContainer

		local tag = Instance_new("BillboardGui")
		tag.Name = "Tag_" .. player.Name
		tag.Adornee = root
		tag.ExtentsOffset = Vector3_new(0, 3.2, 0)
		tag.Size = UDim2.new(0, 140, 0, 25)
		tag.AlwaysOnTop = true
		tag.Enabled = false
		
		local label = Instance_new("TextLabel")
		label.Size = UDim2.new(1, 0, 1, 0)
		label.Text = player.DisplayName
		label.TextColor3 = dynamicColor
		label.BackgroundTransparency = 1
		label.TextSize = 11
		label.Font = Enum.Font.SourceSansBold
		label.Parent = tag
		tag.Parent = EspContainer
	end
end

