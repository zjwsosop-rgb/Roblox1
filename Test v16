local characterParts = {} 
local wasFlying = false 
local wasAscending = false      
local wasFlinging = false       
local savedJoints = {}          
local flingCFrame = CFrame.new() 

local function updateCharPartsCache(char)
	table.clear(characterParts)
	if not char then return end
	for _, part in ipairs(char:GetDescendants()) do if part:IsA("BasePart") then characterParts[part] = true end end
	char.DescendantAdded:Connect(function(p) if p:IsA("BasePart") then characterParts[p] = true end end)
	char.DescendantRemoving:Connect(function(p) characterParts[p] = nil end)
end
localPlayer.CharacterAdded:Connect(updateCharPartsCache)
if localPlayer.Character then updateCharPartsCache(localPlayer.Character) end

RunService.Stepped:Connect(function(time, deltaTime)
	pcall(function()
		local Camera = GetSafeCamera()
		if not Camera then return end
		
		local char = localPlayer.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not root or not hum then return end
		
		local dt = deltaTime or 0.016
		
		if Settings.Speed then hum.WalkSpeed = Settings.WalkSpeed end
		if Settings.HighJump then hum.UseJumpPower = true; hum.JumpPower = Settings.JumpPower end
		
		if Settings.UnlockCameraLimits then
			pcall(function()
				localPlayer.CameraMaxZoomDistance = 99999
				localPlayer.CameraMinZoomDistance = 0.5
			end)
		end

		if Settings.NoClip then
			for p in pairs(characterParts) do 
				if p and p.Parent then 
					if Settings.Fling and (p.Name == "HumanoidRootPart") then
						p.CanCollide = true
					else
						p.CanCollide = false 
					end
				end 
			end
		else
			if Settings.Fling then
				root.CanCollide = true
			end
		end

		if Settings.Spin and not Settings.Ascension and not Settings.Fling then
			root.CFrame = root.CFrame * CFrame_Angles(0, math_rad(Settings.SpinSpeed), 0)
		end

		-- Fling 优化逻辑（无损稳定，避免直接卡死游戏）
		if Settings.Fling then
			if not wasFlinging then
				wasFlinging = true
				flingCFrame = root.CFrame 
			end
			hum.PlatformStand = true 
			
			local moveSpeed = Settings.Speed and Settings.WalkSpeed or 16
			local moveDir = hum.MoveDirection
			local nextPos = flingCFrame.Position + (moveDir * moveSpeed * dt)
			
			local camLook = Camera.CFrame.LookVector
			local flatLook = Vector3_new(camLook.X, 0, camLook.Z)
			if flatLook.Magnitude > 0 then
				flatLook = flatLook.Unit
			else
				flatLook = Vector3_new(0, 0, -1)
			end
			
			flingCFrame = CFrame.lookAt(nextPos, nextPos + flatLook)
			
			if Settings.Spin then
				flingCFrame = flingCFrame * CFrame_Angles(0, math_rad(Settings.SpinSpeed), 0)
			end
			
			root.CFrame = flingCFrame
			root.AssemblyLinearVelocity = Vector3_new(5000, 5000, 5000)
			root.AssemblyAngularVelocity = Vector3_new(0, 5000, 0)
			
			for p in pairs(characterParts) do
				if p and p.Parent and (p.Name ~= "HumanoidRootPart") then
					p.AssemblyLinearVelocity = Vector3_new(5000, 5000, 5000)
					p.AssemblyAngularVelocity = Vector3_new(0, 5000, 0)
				end
			end
		else
			if wasFlinging then
				wasFlinging = false
				if not Settings.Flying and not Settings.Ascension then 
					hum.PlatformStand = false 
				end
				root.AssemblyLinearVelocity = Vector3_new(0, 0, 0)
				root.AssemblyAngularVelocity = Vector3_new(0, 0, 0)
				for p in pairs(characterParts) do
					if p and p.Parent then
						p.AssemblyLinearVelocity = Vector3_new(0, 0, 0)
						p.AssemblyAngularVelocity = Vector3_new(0, 0, 0)
					end
				end
			end
		end
		
		if Settings.Ascension then
			if not wasAscending then
				wasAscending = true
				hum.PlatformStand = true
				
				table.clear(savedJoints)
				for _, j in ipairs(char:GetDescendants()) do
					if j:IsA("Motor6D") then
						savedJoints[j] = j.C0
					end
				end
			end
			
			root.AssemblyLinearVelocity = Vector3_new(0, 4.5, 0)
			root.CFrame = root.CFrame * CFrame_Angles(0, math_rad(1.2), 0)
			
			for joint, originalC0 in pairs(savedJoints) do
				if joint.Parent then
					if (joint.Name == "Right Shoulder") or (joint.Name == "RightShoulder") then
						joint.C0 = CFrame_new(originalC0.Position) * CFrame_Angles(0, 0, math_rad(75)) 
					elseif (joint.Name == "Left Shoulder") or (joint.Name == "LeftShoulder") then
						joint.C0 = CFrame_new(originalC0.Position) * CFrame_Angles(0, 0, math_rad(-75)) 
					elseif (joint.Name == "Right Hip") or (joint.Name == "RightHip") or (joint.Name == "Left Hip") or (joint.Name == "LeftHip") then
						joint.C0 = CFrame_new(originalC0.Position) * CFrame_Angles(0, 0, 0) 
					end
				end
			end
			
			local lightEffect = CardsContainer:FindFirstChild("HolyAscensionEffect_" .. localPlayer.Name)
			if not lightEffect then
				lightEffect = Instance_new("Folder")
				lightEffect.Name = "HolyAscensionEffect_" .. localPlayer.Name
				lightEffect.Parent = CardsContainer
				
				local beamPart = Instance_new("Part")
				beamPart.Name = "DivineBeam"
				beamPart.Shape = Enum.PartType.Cylinder
				beamPart.Size = Vector3_new(1200, 10, 10) 
				beamPart.CFrame = CFrame_new(root.Position) * CFrame_Angles(0, 0, math_rad(90))
				beamPart.Color = Color3.fromRGB(255, 255, 240)
				beamPart.Material = Enum.Material.Neon
				beamPart.Transparency = 0.82
				beamPart.CanCollide = false; beamPart.CanTouch = false; beamPart.CanQuery = false
				beamPart.Anchored = true
				beamPart.Parent = lightEffect

				local outerBeam = beamPart:Clone()
				outerBeam.Name = "OuterDivineBeam"
				outerBeam.Size = Vector3_new(1200, 18, 18)
				outerBeam.Color = Color3.fromRGB(255, 215, 110)
				outerBeam.Transparency = 0.94
				outerBeam.Parent = lightEffect
				
				local rayEmitter = Instance_new("ParticleEmitter")
				rayEmitter.Name = "AscensionRays"
				rayEmitter.Texture = "rbxassetid://258129525" 
				rayEmitter.Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
					ColorSequenceKeypoint.new(0.6, Color3.fromRGB(255, 230, 150)),
					ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 170, 70))
				})
				rayEmitter.Size = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0),
					NumberSequenceKeypoint.new(0.2, 4.5),
					NumberSequenceKeypoint.new(0.8, 5.5),
					NumberSequenceKeypoint.new(1, 0)
				})
				rayEmitter.Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 1),
					NumberSequenceKeypoint.new(0.15, 0.25),
					NumberSequenceKeypoint.new(0.8, 0.45),
					NumberSequenceKeypoint.new(1, 1)
				})
				rayEmitter.Lifetime = NumberRange.new(2.2, 3.6)
				rayEmitter.Rate = 70
				rayEmitter.Speed = NumberRange.new(9, 22)
				rayEmitter.VelocityInheritance = 0.15
				rayEmitter.EmissionDirection = Enum.NormalId.Top
				rayEmitter.SpreadAngle = Vector2_new(12, 12)
				rayEmitter.LightEmission = 0.90
				rayEmitter.Parent = root

				local dustEmitter = Instance_new("ParticleEmitter")
				dustEmitter.Name = "AscensionDust"
				dustEmitter.Texture = "rbxassetid://242293485" 
				dustEmitter.Color = ColorSequence.new(Color3.fromRGB(255, 245, 190))
				dustEmitter.Size = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.4),
					NumberSequenceKeypoint.new(0.5, 1.6),
					NumberSequenceKeypoint.new(1, 0)
				})
				dustEmitter.Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0),
					NumberSequenceKeypoint.new(0.7, 0.2),
					NumberSequenceKeypoint.new(1, 1)
				})
				dustEmitter.Lifetime = NumberRange.new(1.6, 2.8)
				dustEmitter.Rate = 50
				dustEmitter.Speed = NumberRange.new(4, 11)
				dustEmitter.SpreadAngle = Vector2_new(50, 50)
				dustEmitter.RotSpeed = NumberRange.new(-70, 70)
				dustEmitter.LightEmission = 1.0
				dustEmitter.Parent = root

				local haloEmitter = Instance_new("ParticleEmitter")
				haloEmitter.Name = "AscensionHalos"
				haloEmitter.Texture = "rbxassetid://1084991219" 
				haloEmitter.Color = ColorSequence.new(Color3.fromRGB(255, 230, 160))
				haloEmitter.Size = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 2.2),
					NumberSequenceKeypoint.new(1, 8.5)
				})
				haloEmitter.Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 1),
					NumberSequenceKeypoint.new(0.25, 0.4),
					NumberSequenceKeypoint.new(0.8, 0.7),
					NumberSequenceKeypoint.new(1, 1)
				})
				haloEmitter.Lifetime = NumberRange.new(2.0, 2.8)
				haloEmitter.Rate = 7
				haloEmitter.Speed = NumberRange.new(6, 10)
				haloEmitter.EmissionDirection = Enum.NormalId.Top
				haloEmitter.LightEmission = 0.95
				haloEmitter.Parent = root

				local dLight = Instance_new("PointLight")
				dLight.Name = "AscensionLight"
				dLight.Color = Color3.fromRGB(255, 235, 180)
				dLight.Brightness = 6.5
				dLight.Range = 48
				dLight.Shadows = true
				dLight.Parent = root
			else
				local beamPart = lightEffect:FindFirstChild("DivineBeam")
				local outerBeam = lightEffect:FindFirstChild("OuterDivineBeam")
				local curTime = os.clock()
				local pulseFactor = 1 + (math_sin(curTime * 5.5) * 0.06) 
				
				if beamPart then
					beamPart.CFrame = CFrame_new(root.Position.X, root.Position.Y + 200, root.Position.Z) * CFrame_Angles(0, 0, math_rad(90)) * CFrame_Angles(curTime * 2.8, 0, 0)
					beamPart.Size = Vector3_new(1200, 10 * pulseFactor, 10 * pulseFactor)
				end
				if outerBeam then
					outerBeam.CFrame = CFrame_new(root.Position.X, root.Position.Y + 200, root.Position.Z) * CFrame_Angles(0, 0, math_rad(90)) * CFrame_Angles(-curTime * 1.2, 0, 0)
					outerBeam.Size = Vector3_new(1200, 18 * pulseFactor, 18 * pulseFactor)
				end
			end
		else
			if wasAscending then
				wasAscending = false
				hum.PlatformStand = false
				
				root.AssemblyLinearVelocity = Vector3_new(0, 0, 0)
				root.AssemblyAngularVelocity = Vector3_new(0, 0, 0)
				
				local currentLook = root.CFrame.LookVector
				root.CFrame = CFrame.lookAt(root.Position, root.Position + Vector3_new(currentLook.X, 0, currentLook.Z))
				
				for joint, originalC0 in pairs(savedJoints) do
					if joint.Parent then
						joint.C0 = originalC0
					end
				end
				table.clear(savedJoints)
				
				hum:ChangeState(Enum.HumanoidStateType.GettingUp)
				coroutine.wrap(function()
					wait(0.1)
					if hum and hum.Parent then
						hum:ChangeState(Enum.HumanoidStateType.Running)
					end
				end)()
				
				local lightEffect = CardsContainer:FindFirstChild("HolyAscensionEffect_" .. localPlayer.Name)
				if lightEffect then lightEffect:Destroy() end
				
				for _, item in ipairs(char:GetDescendants()) do
					if (item.Name == "AscensionRays") or (item.Name == "AscensionDust") or (item.Name == "AscensionHalos") or (item.Name == "AscensionLight") or (item:IsA("ParticleEmitter") and (item.Parent == root)) then
						item:Destroy()
					end
				end
			end
		end
		
		if Settings.Flying and not Settings.Ascension then
			wasFlying = true
			hum.PlatformStand = true
			
			local moveDir = hum.MoveDirection
			local targetVelocity = Vector3_new(0, 0, 0)
			
			if moveDir.Magnitude > 0 then
				local camLook = Camera.CFrame.LookVector
				local camRight = Camera.CFrame.RightVector
				targetVelocity = ((camLook * moveDir:Dot(camLook)) + (camRight * moveDir:Dot(camRight))).Unit * Settings.FlySpeed
			end
			
			if UserInputService:IsKeyDown(Enum.KeyCode.Space) then 
				targetVelocity = targetVelocity + Vector3_new(0, Settings.FlySpeed, 0) 
			elseif UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then 
				targetVelocity = targetVelocity - Vector3_new(0, Settings.FlySpeed, 0) 
			end
			
			root.AssemblyLinearVelocity = targetVelocity
			
			local lookTarget = root.Position + Vector3_new(Camera.CFrame.LookVector.X, 0, Camera.CFrame.LookVector.Z)
			if (lookTarget - root.Position).Magnitude > 0.01 then
				root.CFrame = CFrame.lookAt(root.Position, lookTarget)
			end
		else
			if wasFlying then
				wasFlying = false
				if not Settings.Ascension then hum.PlatformStand = false end
				root.AssemblyLinearVelocity = Vector3_new(0, 0, 0)
			end
		end
		
		if Settings.NoClip and not Settings.Flying and not Settings.Ascension then
			if hum.MoveDirection.Magnitude == 0 then
				root.AssemblyLinearVelocity = Vector3_new(root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z)
			end
		end

		-- 自瞄跟随与激光线逻辑联动
		local targetPlayer = nil
		local allPlayers = Players:GetPlayers()
		if (Settings.StatusCardTargetIndex > 0) and allPlayers[Settings.StatusCardTargetIndex] then
			targetPlayer = allPlayers[Settings.StatusCardTargetIndex]
		elseif cachedChar then
			targetPlayer = Players:GetPlayerFromCharacter(cachedChar)
		end

		if targetPlayer and targetPlayer.Character then
			local tChar = targetPlayer.Character
			local tRoot = tChar:FindFirstChild("HumanoidRootPart")
			if tRoot then
				if Settings.TeleportBehind then
					root.CFrame = tRoot.CFrame * CFrame_new(0, 0, 3.5) 
					root.AssemblyLinearVelocity = Vector3_new(0, 0, 0)
				elseif Settings.AutoFollow then
					local dist = (tRoot.Position - root.Position).Magnitude
					if dist > 5 then
						hum:MoveTo(tRoot.Position)
					end
				end

				local isPathWanted = Settings.ShowPath or (Settings.AutoFollow and not Settings.TeleportBehind)
				if isPathWanted then
					local attA = root:FindFirstChild("FlashPathAttA") or Instance_new("Attachment", root)
					attA.Name = "FlashPathAttA"
					
					local attB = tRoot:FindFirstChild("FlashPathAttB") or Instance_new("Attachment", tRoot)
					attB.Name = "FlashPathAttB"
					
					local beam = VisualsContainer:FindFirstChild("FlashPathBeam")
					if not beam then
						beam = Instance_new("Beam")
						beam.Name = "FlashPathBeam"
						beam.Width0 = 0.15
						beam.Width1 = 0.15
						beam.Color = ColorSequence.new(Theme.Accent) 
						beam.FaceCamera = true
						beam.Parent = VisualsContainer
					end
					beam.Attachment0 = attA
					beam.Attachment1 = attB
					beam.Enabled = true
				else
					local beam = VisualsContainer:FindFirstChild("FlashPathBeam")
					if beam then beam:Destroy() end
					
					local attA = root:FindFirstChild("FlashPathAttA")
					if attA then attA:Destroy() end
					
					local attB = tRoot:FindFirstChild("FlashPathAttB")
					if attB then attB:Destroy() end
				end
			else
				local beam = VisualsContainer:FindFirstChild("FlashPathBeam")
				if beam then beam:Destroy() end
			end
		else
			local beam = VisualsContainer:FindFirstChild("FlashPathBeam")
			if beam then beam:Destroy() end
			
			local attA = root:FindFirstChild("FlashPathAttA")
			if attA then attA:Destroy() end
			
			for _, p in ipairs(Players:GetPlayers()) do
				if p.Character then
					local tRt = p.Character:FindFirstChild("HumanoidRootPart")
					if tRt then
						local attB = tRt:FindFirstChild("FlashPathAttB")
						if attB then attB:Destroy() end
					end
				end
			end
		end
	end)
end)

