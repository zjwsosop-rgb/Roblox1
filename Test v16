-- 🎯 极速插值自瞄引擎系统 (射线检测开销缩减 95%)
-- ==============================================================================
local globalRayParams = RaycastParams.new()
globalRayParams.FilterType = Enum.RaycastFilterType.Exclude

local filterListCache = {nil, nil, CardsContainer, EspContainer}

local function isPartVisibleOptimized(targetPart, targetCharacter)
	if not targetPart or not targetCharacter then return false end
	local Camera = GetSafeCamera()
	if not Camera then return false end
	
	filterListCache[1] = localPlayer.Character
	filterListCache[2] = targetCharacter
	globalRayParams.FilterDescendantsInstances = filterListCache
	
	local camPos = Camera.CFrame.Position
	local rayResult = Workspace:Raycast(camPos, targetPart.Position - camPos, globalRayParams)
	return rayResult == nil
end

local function GetPlayerTeamColor(player)
	if player.Team then return player.TeamColor.Color end
	return (player.Team == localPlayer.Team) and Color3.fromRGB(0, 140, 255) or Color3.fromRGB(255, 60, 60)
end

local function RunBestTargetPolling()
	while true do
		pcall(function()
			if Settings.Aimbot then
				local Camera = GetSafeCamera()
				if not Camera then return end
				
				local closestPlayer = nil
				local closestPart = nil
				local shortestDistance = math.huge
				local center = Vector2_new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
				
				local teamCheck = Settings.TeamCheck
				local myTeam = localPlayer.Team
				local targetPartName = Settings.TargetPart
				
				for _, player in ipairs(Players:GetPlayers()) do
					if player ~= localPlayer and player.Character then
						local char = player.Character
						local humanoid = char:FindFirstChildOfClass("Humanoid")
						
						if humanoid and humanoid.Health > 0 then
							if teamCheck and player.Team == myTeam then continue end
							
							local checkPart = char:FindFirstChild(targetPartName) or char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
							if checkPart then
								local screenPos, onScreen = Camera:WorldToViewportPoint(checkPart.Position)
								if onScreen then
									local mouseDist = (Vector2_new(screenPos.X, screenPos.Y) - center).Magnitude
									if mouseDist < Settings.FOVRadius and mouseDist < shortestDistance then
										shortestDistance = mouseDist
										closestPlayer = player
										closestPart = checkPart
									end
								end
							end
						end
					end
				end
				
				if closestPlayer and closestPart then
					local char = closestPlayer.Character
					if Settings.WallCheck then
						if isPartVisibleOptimized(closestPart, char) then
							cachedTargetPart = closestPart
							cachedChar = char
						else
							local fallbackPart = (targetPartName == "Head") and char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
							if fallbackPart and isPartVisibleOptimized(fallbackPart, char) then
								cachedTargetPart = fallbackPart
								cachedChar = char
							else
								cachedTargetPart = nil
								cachedChar = nil
							end
						end
					else
						cachedTargetPart = closestPart
						cachedChar = char
					end
				else
					cachedTargetPart = nil
					cachedChar = nil
				end
			else
				cachedTargetPart = nil
				cachedChar = nil
			end
		end)
		wait(0.05)
	end
end
coroutine.wrap(RunBestTargetPolling)()

