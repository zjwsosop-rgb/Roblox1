	-- Slider 滑块
	local function createWindSlider(parent, title, minVal, maxVal, defaultVal, callback)
		local card = BuildComponentBase(parent, title, nil, 46)
		local txtValue = Instance_new("TextLabel", card)
		txtValue.Size = UDim2.new(0, 50, 1, 0)
		txtValue.Position = UDim2.new(1, -165, 0, 0)
		txtValue.BackgroundTransparency = 1
		txtValue.Text = string.format("%.1f", defaultVal)
		txtValue.TextColor3 = Theme.Accent
		txtValue.TextSize = 12
		txtValue.Font = Enum.Font.SourceSansBold
		txtValue.TextXAlignment = Enum.TextXAlignment.Right
		
		local bgBar = Instance_new("Frame", card)
		bgBar.Size = UDim2.new(0, 100, 0, 4)
		bgBar.Position = UDim2.new(1, -112, 0.5, -2)
		bgBar.BackgroundColor3 = Theme.Sidebar
		bgBar.BorderSizePixel = 0
		Instance_new("UICorner", bgBar).CornerRadius = UDim.new(1, 0)
		
		local fillBar = Instance_new("Frame", bgBar)
		fillBar.Size = UDim2.new((defaultVal - minVal) / (maxVal - minVal), 0, 1, 0)
		fillBar.BackgroundColor3 = Theme.Accent
		fillBar.BorderSizePixel = 0
		Instance_new("UICorner", fillBar).CornerRadius = UDim.new(1, 0)
		
		local thumb = Instance_new("Frame", bgBar)
		thumb.AnchorPoint = Vector2_new(0.5, 0.5)
		thumb.Position = UDim2.new((defaultVal - minVal) / (maxVal - minVal), 0, 0.5, 0)
		thumb.Size = UDim2.new(0, 10, 0, 10)
		thumb.BackgroundColor3 = Theme.TextMain
		thumb.BorderSizePixel = 0
		Instance_new("UICorner", thumb).CornerRadius = UDim.new(1, 0)
		Instance_new("UIStroke", thumb).Color = Theme.Accent
		
		local trigger = Instance_new("TextButton", bgBar)
		trigger.Size = UDim2.new(1, 10, 6, 0)
		trigger.Position = UDim2.new(0, -5, 0, -5)
		trigger.BackgroundTransparency = 1
		trigger.Text = ""
		
		local function updateValue(input)
			local posX = math_clamp((input.Position.X - bgBar.AbsolutePosition.X) / bgBar.AbsoluteSize.X, 0, 1)
			fillBar.Size = UDim2.new(posX, 0, 1, 0)
			thumb.Position = UDim2.new(posX, 0, 0.5, 0)
			local finalVal = minVal + (posX * (maxVal - minVal))
			txtValue.Text = string.format("%.1f", finalVal)
			callback(finalVal)
		end
		
		local dragging = false
		trigger.InputBegan:Connect(function(input) 
			if (input.UserInputType == Enum.UserInputType.MouseButton1) or (input.UserInputType == Enum.UserInputType.Touch) then 
				dragging = true
				updateValue(input) 
			end 
		end)
		UserInputService.InputChanged:Connect(function(input) 
			if dragging and ((input.UserInputType == Enum.UserInputType.MouseMovement) or (input.UserInputType == Enum.UserInputType.Touch)) then 
				updateValue(input) 
			end 
		end)
		UserInputService.InputEnded:Connect(function(input) 
			if (input.UserInputType == Enum.UserInputType.MouseButton1) or (input.UserInputType == Enum.UserInputType.Touch) then 
				dragging = false 
			end 
		end)
	end

