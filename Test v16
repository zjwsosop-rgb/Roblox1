	local function decodeHTMLEntities(text)
		if not text then return "" end
		local entities = {
			["&amp;"] = "&", ["&lt;"] = "<", ["&gt;"] = ">",
			["&quot;"] = "\"", ["&apos;"] = "'", ["&#39;"] = "'",
			["&#40;"] = "(", ["&#41;"] = ")", ["&nbsp;"] = " "
		}
		for entity, replacement in pairs(entities) do
			text = text:gsub(entity, replacement)
		end
		return text
	end

	local function parseLRC(lrcText)
		local lyrics = {}
		if not lrcText or lrcText == "" then return lyrics end
		for line in lrcText:gmatch("[^\r\n]+") do
			line = decodeHTMLEntities(line)
			local min, sec = line:match("^%s*%[(%d+):(%d+%.?%d*)%]")
			local text = line:gsub("^%s*%[%d+:%d+%.?%d*%]", "")
			
			if min and sec then
				local totalTime = tonumber(min) * 60 + tonumber(sec)
				text = text:gsub("^%s*(.-)%s*$", "%1")
				if not text:match("^%a+:") then 
					table.insert(lyrics, { time = totalTime, text = text })
				end
			end
		end
		table.sort(lyrics, function(a, b) return a.time < b.time end)
		return lyrics
	end

	local function mergeAndTranslateLyrics(rawLrc, translatedLrc)
		local rawList = parseLRC(rawLrc)
		local transList = parseLRC(translatedLrc)
		local merged = {}

		for _, item in ipairs(rawList) do
			local matchedTranslation = ""
			for _, trans in ipairs(transList) do
				if math.abs(trans.time - item.time) < 0.25 then
					matchedTranslation = trans.text
					break
				end
			end

			table.insert(merged, {
				time = item.time,
				text = item.text,
				translation = (matchedTranslation ~= "") and matchedTranslation or nil
			})
		end

		return merged
	end

