-- 🚀 步进物理主驱动循环 (多线程逻辑融合及流畅残影控制)
-- ==============================================================================
local lastAfterimageTime = 0
local lastAfterimagePos = Vector3_new()
local activeAfterimageCount = 0
local maxAfterimages = 12

RunService.Heartbeat:Connect(function(dt)
	pcall(function()
		local now = os.clock()
		dt = math_clamp(dt, 0.005, 0.05) 
		
		if Settings.ShowStatusCard then
			for player, cardData in pairs(ActiveCards) do
				local cardPart = cardData.Part
				local tChar = player.Character
				local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
				
				if not cardPart or not cardPart.Parent or not tRoot or not tRoot.Parent then
					ClearStatusCard(player)
					continue
				end
				
				local isSelf = (player == localPlayer)
				
				if not isSelf and ((now - cardData.LastCheck) > 0.15) then
					cardData.LastCheck = now
					local currentVisible = isPartVisibleOptimized(tRoot, tChar)
					
					if cardData.IsVisible ~= currentVisible then
						cardData.IsVisible = currentVisible
						for _, child in ipairs(cardPart:GetChildren()) do
							if child:IsA("SurfaceGui") then child.Enabled = currentVisible end
						end
						
						if currentVisible then
							cardPart.Size = Vector3_new(0, 0, 0) 
							TweenService:Create(cardPart, TweenInfo.new(1.0, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
								Size = Vector3_new(5.6, 2.6, 0.05)
							}):Play()
						end
					end
				end
				
				if isSelf or cardData.IsVisible then
					local bobbingY = math_sin(now * 2.8) * 0.16
					local targetCFrame = tRoot.CFrame * cardOffset * CFrame_new(0, bobbingY, 0)
					
					local currentPos = cardPart.Position
					local targetPos = targetCFrame.Position
					local displacement = currentPos - targetPos
					
					local springForce = -SpringConfig.Stiffness * displacement
					local dampingForce = -SpringConfig.Damping * cardData.Velocity
					local acceleration = springForce + dampingForce
					
					cardData.Velocity = cardData.Velocity + (acceleration * dt)
					local nextPosition = currentPos + (cardData.Velocity * dt)
					
					local targetRotation = targetCFrame - targetCFrame.Position
					cardPart.CFrame = CFrame_new(nextPosition) * targetRotation
				end
			end
		end

		if Settings.Afterimages and activeAfterimageCount < maxAfterimages then
			local char = localPlayer.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			if root and root.AssemblyLinearVelocity.Magnitude > 15 then
				if (now - lastAfterimageTime > 0.08) and (root.Position - lastAfterimagePos).Magnitude > 2.2 then
					lastAfterimageTime = now
					lastAfterimagePos = root.Position
					
					for _, item in ipairs(char:GetDescendants()) do
						if item:IsA("BasePart") and (item.Name ~= "HumanoidRootPart") and not item.Parent:IsA("Tool") then
							if item.Transparency < 0.9 then
								pcall(function()
									activeAfterimageCount = activeAfterimageCount + 1
									local ghost = Instance_new("Part")
									ghost.Size = item.Size
									ghost.CFrame = item.CFrame
									ghost.Anchored = true
									ghost.CanCollide = false
									ghost.CanTouch = false
									ghost.CanQuery = false
									ghost.Material = Enum.Material.Neon
									ghost.Color = Color3.fromRGB(245, 248, 255)
									ghost.Transparency = 0.55
									ghost.Parent = CardsContainer
									
									local originalMesh = item:FindFirstChildOfClass("SpecialMesh")
									if originalMesh then
										originalMesh:Clone().Parent = ghost
									end
									
									local tw = TweenService:Create(ghost, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
										Transparency = 1,
										Size = ghost.Size * 0.85
									})
									tw:Play()
									
									coroutine.wrap(function()
										tw.Completed:Wait()
										ghost:Destroy()
										activeAfterimageCount = activeAfterimageCount - 1
									end)()
								end)
							end
						end
					end
				end
			end
		end
	end)
end)

local function RunCardTargetLoop()
	while true do
		pcall(function()
			if Settings.ShowStatusCard then
				local allPlayers = Players:GetPlayers()
				
				if Settings.StatusCardTargetIndex == 0 then
					for _, player in ipairs(allPlayers) do
						local pChar = player.Character
						if pChar and pChar:FindFirstChild("HumanoidRootPart") then
							if not ActiveCards[player] then CreateActual3DCard(player) end
						else
							if ActiveCards[player] then ClearStatusCard(player) end
						end
					end
					for player, _ in pairs(ActiveCards) do
						if not table.find(allPlayers, player) then ClearStatusCard(player) end
					end
				else
					if Settings.StatusCardTargetIndex > #allPlayers then Settings.StatusCardTargetIndex = 0 end
					local targetPlayer = allPlayers[Settings.StatusCardTargetIndex]
					if targetPlayer then
						for player, _ in pairs(ActiveCards) do
							if player ~= targetPlayer then ClearStatusCard(player) end
						end
						local tChar = targetPlayer.Character
						if tChar and tChar:FindFirstChild("HumanoidRootPart") then
							if not ActiveCards[targetPlayer] then CreateActual3DCard(targetPlayer) end
						else
							if ActiveCards[targetPlayer] then ClearStatusCard(targetPlayer) end
						end
					else
						ClearAllStatusCards()
					end
				end
			else
				if next(ActiveCards) ~= nil then ClearAllStatusCards() end
			end
		end)
		wait(0.5)
	end
end
coroutine.wrap(RunCardTargetLoop)()

