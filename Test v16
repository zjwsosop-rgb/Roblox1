-- 🌐 游戏内文字全局翻译引擎
-- ==============================================================================
local TranslationCache = {}; local ActiveTextConnections = {} 
local function safeHttpRequest(url) local req = (fluxus and fluxus.request) or (syn and syn.request) or request or http_request; if req then local s,r = pcall(function() return req({ Url = url, Method = "GET" }) end); if s and r and r.StatusCode == 200 then return r.Body end end; local s,r = pcall(function() return game:HttpGet(url) end); if s then return r end; return nil end

local function fetchGoogleTranslation(text, targetLang)
	if not text or text == "" then return text end
	if TranslationCache[text] then return TranslationCache[text] end
	local richPrefix, richSuffix = "", ""
	if text:find("<") and text:find(">") then richPrefix = text:match("^(<.->)") or ""; richSuffix = text:match("(</.->)$") or ""; text = text:gsub("<.->","") end
	if not text:match("%a") and not text:find("[\227-\233]") then return richPrefix .. text .. richSuffix end
	local s, result = pcall(function()
		local url = "https://translate.googleapis.com/translate_a/single?client=gtx&sl=auto&tl="..targetLang.."&dt=t&q="..HttpService:UrlEncode(text)
		local body = safeHttpRequest(url)
		if body and body ~= "" then
			local data = HttpService:JSONDecode(body)
			if data and data[1] then
				local parts = {}; for _, part in ipairs(data[1]) do if part[1] then table.insert(parts, tostring(part[1])) end end
				local resultText = table.concat(parts)
				if resultText and resultText ~= "" then return resultText end
			end
		end
	end)
	if s and result then TranslationCache[text] = result; return richPrefix .. result .. richSuffix end
	return richPrefix .. text .. richSuffix
end

local function HookTextInstance(instance)
	if not instance:IsA("TextLabel") and not instance:IsA("TextBox") and not instance:IsA("TextButton") then return end
	if instance:IsDescendantOf(GetGuiParent()) then return end
	if not instance:GetAttribute("OriginalText") then instance:SetAttribute("OriginalText", instance.Text) end
	local isTranslating = false
	local function processText()
		if isTranslating or not Settings.GameTranslation then return end
		isTranslating = true
		local currentText = instance.Text
		if currentText ~= "" and currentText ~= instance:GetAttribute("TranslatedText") then
			instance:SetAttribute("OriginalText", currentText)
			coroutine.wrap(function()
				local translated = fetchGoogleTranslation(currentText, "zh-CN")
				if translated and translated ~= currentText then instance:SetAttribute("TranslatedText", translated); instance.Text = translated end
				isTranslating = false
			end)()
		else isTranslating = false end
	end
	local conn = instance:GetPropertyChangedSignal("Text"):Connect(processText)
	ActiveTextConnections[instance] = conn
	if Settings.GameTranslation then processText() end
end

local function SetGameTranslationEnabled(enabled)
	Settings.GameTranslation = enabled
	if enabled then
		local playerGui = localPlayer:FindFirstChildOfClass("PlayerGui")
		if playerGui then for _, child in ipairs(playerGui:GetDescendants()) do pcall(HookTextInstance, child) end end
		if not game:GetAttribute("TranslationHooked") then game:SetAttribute("TranslationHooked", true); game.DescendantAdded:Connect(function(child) if child:IsDescendantOf(localPlayer) then pcall(HookTextInstance, child) end end) end
	else
		for instance, conn in pairs(ActiveTextConnections) do if conn then conn:Disconnect() end; local orig = instance:GetAttribute("OriginalText"); if orig then instance.Text = orig end end; table.clear(ActiveTextConnections)
	end
end

