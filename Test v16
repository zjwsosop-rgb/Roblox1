local function RunEspLoop()
	while wait(0.3) do
		pcall(function()
			if not Settings.ESP then 
				EspContainer:ClearAllChildren()
				return 
			end
			
			for _, playerObj in ipairs(Players:GetPlayers()) do
				if playerObj ~= localPlayer and playerObj.Character then
					local char = playerObj.Character
					local glow = EspContainer:FindFirstChild("Glow_" .. playerObj.Name)
					local tag = EspContainer:FindFirstChild("Tag_" .. playerObj.Name)
					
					if not glow or not tag then 
						ApplyESPToCharacter(playerObj, char)
						glow = EspContainer:FindFirstChild("Glow_" .. playerObj.Name)
						tag = EspContainer:FindFirstChild("Tag_" .. playerObj.Name)
					end
					
					local currentTeamColor = GetPlayerTeamColor(playerObj)
					if glow then 
						glow.Enabled = true
						glow.Adornee = char
						glow.FillColor = currentTeamColor 
					end
					if tag then 
						tag.Enabled = Settings.ESP_Names
						tag.Adornee = char:FindFirstChild("HumanoidRootPart")
						local lbl = tag:FindFirstChildOfClass("TextLabel")
						if lbl then lbl.TextColor3 = currentTeamColor end 
					end
				end
			end
			
			for _, child in ipairs(EspContainer:GetChildren()) do
				local prefix, pName = child.Name:match("([^_]+)_(.+)")
				if pName then
					local p = Players:FindFirstChild(pName)
					if not p or not p.Character or not p.Character:FindFirstChild("HumanoidRootPart") then
						child:Destroy()
					end
				end
			end
		end)
	end
end
coroutine.wrap(RunEspLoop)()

