						if lastTargetUserId ~= targetPlayer.UserId then
							lastTargetUserId = targetPlayer.UserId; dNameLabel.Text = targetPlayer.DisplayName; uNameLabel.Text = "@" .. targetPlayer.Name
							if thumbnailCache[targetPlayer.UserId] then avatarImg.Image = thumbnailCache[targetPlayer.UserId] else
