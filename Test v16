			end
			
			if Settings.ShowFPS then fpsTimer = fpsTimer + dt; if fpsTimer >= 0.15 then fpsLabel.Text = "FPS: " .. math.floor(1 / dt); fpsTimer = 0 end end

			if Settings.Aimbot then
				if cachedTargetPart and cachedChar and cachedChar:FindFirstChildOfClass("Humanoid") and (cachedChar:FindFirstChildOfClass("Humanoid").Health > 0) then
					local targetPos = cachedTargetPart.Position; local targetPlayer = Players:GetPlayerFromCharacter(cachedChar)
