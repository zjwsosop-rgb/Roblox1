local activeNotifs = 0
function TriggerNotification(rawText, state)
	if not Settings.Notifications then return end
	local screenGui = GetGuiParent():FindFirstChild("ObsidianMobileGui")
	if not screenGui then return end
	
	local cleanName = rawText
	local colonIdx = string.find(rawText, ":")
	if colonIdx then
		cleanName = string.sub(rawText, 1, colonIdx - 1)
	end
	cleanName = cleanName:gsub(" enabled$", ""):gsub(" disabled$", ""):match("^%s*(.-)%s*$") or cleanName
	
	activeNotifs = activeNotifs + 1
	local myIndex = activeNotifs
	
	local notifFrame = Instance_new("Frame", screenGui)
	notifFrame.Size = UDim2.new(0, 180, 0, 36)
	notifFrame.Position = UDim2.new(1, 200, 0.22, (myIndex - 1) * 42)
	notifFrame.BackgroundColor3 = Theme.Sidebar
	notifFrame.BackgroundTransparency = 0.1
	
	Instance_new("UICorner", notifFrame).CornerRadius = UDim.new(0, 6)
	
	local stroke = Instance_new("UIStroke", notifFrame)
	stroke.Thickness = 1
	stroke.Color = state and Theme.Accent or Theme.Border
	stroke.LineJoinMode = Enum.LineJoinMode.Round
	
	local lbl = Instance_new("TextLabel", notifFrame)
