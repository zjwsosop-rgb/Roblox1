							local enemyVelocity = rootPart.AssemblyLinearVelocity
							
							local leadTime = (distance / 200) * Settings.PredictAmount * 10
							targetPos = targetPos + (enemyVelocity * leadTime)
						end
					end
					
					if (targetPos - Camera.CFrame.Position).Magnitude > 0.1 then
