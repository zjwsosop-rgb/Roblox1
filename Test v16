local function AskAIAssistant(prompt)
	local fallbackResponses = {
		"Sorry, I couldn't find the relevant info in my quantum thoughts, let's change the topic!",
		"Seems my transmission gateway fluctuated, please resend. You can also type commands like 'jump 300' and I'll execute instantly!",
		"Synchronizing Roblox environment parameters. I was distracted, tell me how you want your battlefield adjusted!"
	}
	
	local pLower = prompt:lower()
	local actionTaken = ""
	
	-- 复合意图解析与物理控制引擎绑定
	if pLower:find("esp") or pLower:find("aimbot") or pLower:find("lock") then
		if pLower:find("on") or pLower:find("enable") then
			if pLower:find("aimbot") or pLower:find("lock") then
				Settings.Aimbot = true
				pcall(updateMenuAimbotButton)
				pcall(updateAimShortcutButton)
				actionTaken = "🎯 [AI Action] Aimbot locking system calibrated and activated!"
			else
				Settings.ESP = true
				actionTaken = "👁️ [AI Action] Successfully injected full-map ESP rendering matrix!"
			end
		elseif pLower:find("off") or pLower:find("disable") or pLower:find("close") then
			if pLower:find("aimbot") or pLower:find("lock") then
				Settings.Aimbot = false
				pcall(updateMenuAimbotButton)
				pcall(updateAimShortcutButton)
				actionTaken = "🎯 [AI Action] Aimbot system intelligently disabled."
			else
				Settings.ESP = false
				actionTaken = "👁️ [AI Action] ESP matrix closed and cache cleared."
			end
		end
	elseif pLower:find("fly") or pLower:find("flight") or pLower:find("float") then
		if pLower:find("off") or pLower:find("disable") then
			Settings.Flying = false
			actionTaken = "✈️ [AI Action] Flight mode canceled, character returned to standard gravity."
		else
			Settings.Flying = true
			actionTaken = "✈️ [AI Action] Flight overload activated! Use Space/Shift to control altitude."
		end
	elseif pLower:find("speed") or pLower:find("fast") or pLower:find("move") then
		local num = tonumber(pLower:match("%d+"))
		if num then
			Settings.WalkSpeed = num
			Settings.Speed = true
			actionTaken = string.format("🏃 [AI Action] Physical walking enabled, forced movement speed override: %.1f", num)
		else
			Settings.Speed = not Settings.Speed
			actionTaken = string.format("🏃 [AI Action] Speed limit toggle: %s", Settings.Speed and "[ON]" or "[OFF]")
		end
	elseif pLower:find("jump") or pLower:find("power") or pLower:find("high") then
		local num = tonumber(pLower:match("%d+"))
		if num then
			Settings.JumpPower = num
			Settings.HighJump = true
			actionTaken = string.format("🆙 [AI Action] Jump anti-gravity reset, jump constant adjusted to: %.1f", num)
		else
			Settings.HighJump = not Settings.HighJump
			actionTaken = string.format("🆙 [AI Action] Super jump state toggle: %s", Settings.HighJump and "[ON]" or "[OFF]")
		end
	elseif pLower:find("noclip") or pLower:find("wall") or pLower:find("ghost") then
		if pLower:find("off") or pLower:find("disable") then
			Settings.NoClip = false
			actionTaken = "👻 [AI Action] No-clip collision disabled."
		else
			Settings.NoClip = true
			actionTaken = "👻 [AI Action] Grid collision bypassed, ready for smooth wallhacking."
		end
	elseif pLower:find("fling") or pLower:find("crash") or pLower:find("launch") then
		if pLower:find("off") or pLower:find("disable") then
			Settings.Fling = false
			actionTaken = "💥 [AI Action] Fling engine disabled."
		else
			Settings.Fling = true
			actionTaken = "💥 [AI Action] Extreme fling engine activated! Approaching target automatically flings them out of bounds."
		end
	end

	-- 主动状态通知
	if actionTaken ~= "" and TriggerNotification then
		pcall(function() TriggerNotification(actionTaken, true) end)
	end

	-- 调用真实 AI 模型
	local success, reply = pcall(function()
		local apiUrl = "https://api.gptplus.one/v1/chat/completions"
		local headers = {
			["Content-Type"] = "application/json"
		}
		local body = {
			model = "gpt-3.5-turbo",
			messages = {
				{role = "system", content = "You are a cute AI assistant, answer in English, concise and friendly."},
				{role = "user", content = prompt}
			},
			temperature = 0.7,
			max_tokens = 150
		}
		local response = httpRequest(apiUrl, "POST", headers, HttpService:JSONEncode(body))
		if response and response ~= "" then
			local data = HttpService:JSONDecode(response)
			if data and data.choices and data.choices[1] and data.choices[1].message then
				return data.choices[1].message.content
			end
		end
		return nil
	end)

	if success and reply then
		if actionTaken ~= "" then
			return actionTaken .. "\n\n🤖 Assistant reply: " .. reply
		else
			return reply
		end
	else
		if actionTaken ~= "" then
			return actionTaken .. "\n\n⚠️ AI connection failed, but local intent successfully parsed and executed!"
		else
			return fallbackResponses[math.random(1, #fallbackResponses)]
		end
	end
end

