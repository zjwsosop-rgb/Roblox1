		lyricLabel2.Text = "Current track: " .. track.title .. " - " .. track.artist
		
		refreshMusicListUI()
		
		coroutine.wrap(function()
			if track.id and (track.id ~= 0) then
				pcall(function()
					local lrcUrl = "https://music.163.com/api/song/lyric?id=" .. tostring(track.id) .. "&lv=1&kv=1&tv=-1"
					local lrcHeaders = {
						["Referer"] = "https://music.163.com/",
						["Cookie"] = "os=iphone; osversion=15.0; appver=8.7.0;"
					}
					local lrcBody = httpRequest(lrcUrl, "GET", lrcHeaders)
					if lrcBody and (lrcBody ~= "") then
						local s, parsed = pcall(function() return HttpService:JSONDecode(lrcBody) end)
						if s and parsed then
							local originalLyric = parsed.lrc and parsed.lrc.lyric or ""
							local translatedLyric = parsed.tlyric and parsed.tlyric.lyric or ""
							currentLyrics = mergeAndTranslateLyrics(originalLyric, translatedLyric)
						end
					end
				end)
			end
			if #currentLyrics == 0 then
				currentLyrics = {
					{ time = 0, text = "🎵 " .. track.title, translation = "Artist: " .. track.artist },
					{ time = 5, text = "✨ No scrolling lyrics", translation = "Just enjoy the melody ~" }
				}
			end
		end)()

		coroutine.wrap(function()
			local success, err = pcall(function()
				if track.url and track.url:match("^http") then
					mTrackLabel.Text = "📥 Loading audio: " .. track.title
					
					local playUrl = track.url
					if track.isVip then
						mTrackLabel.Text = "🔓 Bypassing VIP encryption..."
						local matchKeyword = HttpService:UrlEncode(track.title .. " " .. track.artist)
						local foundPlayableUrl = nil
						
						local metingEndpoints = {
							"https://api.injahow.cn/meting/",
							"https://meting.asg6.top/",
							"https://api.i-meto.com/meting/api"
						}
						local searchServers = {"kuwo", "migu", "netease"}
						
						for _, endpoint in ipairs(metingEndpoints) do
							if foundPlayableUrl then break end
							for _, server in ipairs(searchServers) do
								if foundPlayableUrl then break end
								pcall(function()
									mTrackLabel.Text = "⚡ Penetrating: [" .. server:upper() .. "] link..."
									local searchUrl = endpoint .. "?server=" .. server .. "&type=search&id=" .. matchKeyword .. "&limit=1"
									local searchRes = httpRequest(searchUrl, "GET")
									if searchRes and (searchRes ~= "") and not searchRes:match("^<!DOCTYPE") then
										local s1, data = pcall(function() return HttpService:JSONDecode(searchRes) end)
										if s1 and data and data[1] and data[1].id then
											local urlUrl = endpoint .. "?server=" .. server .. "&type=url&id=" .. tostring(data[1].id)
											local urlRes = httpRequest(urlUrl, "GET")
											if urlRes then
												local s2, uData = pcall(function() return HttpService:JSONDecode(urlRes) end)
												if s2 and uData and uData.url and (#uData.url > 10) and not uData.url:match("preview") then
													foundPlayableUrl = uData.url:gsub("\\/", "/"):gsub("%s+", "")
												end
											end
										end
									end
								end)
							end
						end
						
						if foundPlayableUrl then
							playUrl = foundPlayableUrl
						else
							pcall(function()
								local kwSearchUrl = "http://search.kuwo.cn/r.s?client=kt&all=" .. matchKeyword .. "&pn=0&rn=3&rformat=json&encoding=utf8"
								local kwSearchRes = httpRequest(kwSearchUrl, "GET")
								if kwSearchRes and (kwSearchRes ~= "") then
									local rid = kwSearchRes:match('"MUSICRID"%s*:%s*"MUSIC_(%d+)"') or kwSearchRes:match('"rid"%s*:%s*(%d+)')
									if rid then
										local kwPlayUrl = "http://antiserver.kuwo.cn/anti.s?type=convert_url&rid=MUSIC_" .. rid .. "&format=mp3&response=url"
										local kwAudioUrl = httpRequest(kwPlayUrl, "GET")
										if kwAudioUrl and kwAudioUrl:match("^http") and (#kwAudioUrl > 20) then
											foundPlayableUrl = kwAudioUrl:gsub("%s+", "")
										end
									end
								end
							end)
							if foundPlayableUrl then playUrl = foundPlayableUrl end
						end
					end

					local customHeaders = { ["Accept"] = "*/*" }
					if playUrl:match("163%.com") or playUrl:match("netease") then
						customHeaders["Referer"] = "https://music.163.com/"
					elseif playUrl:match("qq%.com") then
						customHeaders["Referer"] = "https://y.qq.com/"
					end

					local audioData = httpRequest(playUrl, "GET", customHeaders)
					
					if audioData and (#audioData > 6000) and not audioData:match("^<!DOCTYPE") and not audioData:match("^<html") then
						currentFileToggle = not currentFileToggle
						local fileName = currentFileToggle and "flash_music_a.mp3" or "flash_music_b.mp3"
						
						writefile(fileName, audioData)
						Sound.SoundId = getcustomasset(fileName)
						Sound:Play()
						mTrackLabel.Text = "🎵 Playing: " .. track.title .. " - " .. track.artist
					else
						if track.isVip then
							mTrackLabel.Text = "🔄 Trying direct audio grab..."
							local rawData = httpRequest(track.url, "GET")
							if rawData and (#rawData > 6000) then
								currentFileToggle = not currentFileToggle
								local fileName = currentFileToggle and "flash_music_a.mp3" or "flash_music_b.mp3"
								writefile(fileName, rawData)
								Sound.SoundId = getcustomasset(fileName)
								Sound:Play()
								return
							end
						end
						warn("[Flash] VIP track loading failed, playing fallback audio.")
						Sound.SoundId = "rbxassetid://1843420489" 
						Sound:Play()
						mTrackLabel.Text = "🎵 Playing fallback audio: " .. track.title
					end
				else
					local assetId = track.url:match("%d+")
					if assetId then
						Sound.SoundId = "rbxassetid://" .. assetId
						Sound:Play()
						mTrackLabel.Text = "🎵 Playing: " .. track.title .. " - " .. track.artist
					else
						error("Unrecognized audio track")
					end
				end
			end)
			
			if not success then
				mTrackLabel.Text = "❌ Playback failed"
				btnPlay.Text = "▶"
			end
		end)()
	end

	local function requestMusicApi(keyword)
		if (keyword == "") or IsMusicSearching then return end
		IsMusicSearching = true
		mSearchBtn.Text = "Searching"
		mTrackLabel.Text = "🔍 Searching cross-server..."
		
		coroutine.wrap(function()
			local encoded = HttpService:UrlEncode(keyword)
			local url = "https://music.163.com/api/search/get?s=" .. encoded .. "&type=1&limit=8"
			local response = httpRequest(url, "GET", {
				["Referer"] = "https://music.163.com/",
				["Cookie"] = "os=iphone; osversion=15.0; appver=8.7.0;"
			})
			
			local newPlaylist = {}
			if response and (response ~= "") and not response:match("^<!DOCTYPE") then
				local success, parsed = pcall(function() return HttpService:JSONDecode(response) end)
				if success and parsed and parsed.result and parsed.result.songs then
					for i = 1, #parsed.result.songs do
						local song = parsed.result.songs[i]
						if song and song.id then
							local artistName = "Unknown Artist"
							if song.artists and song.artists[1] then
								artistName = song.artists[1].name
							end
							
							local isVipTrack = (song.fee == 1 or song.fee == 4)
							
							table.insert(newPlaylist, {
								id = song.id,
								title = song.name or "Unknown Track",
								artist = artistName,
								isVip = isVipTrack,
								url = "http://music.163.com/song/media/outer/url?id=" .. tostring(song.id) .. ".mp3"
							})
						end
					end
				end
			end
			
			if #newPlaylist > 0 then
				SearchPlaylist = newPlaylist
				ShowingFavorites = false
				MusicPlaylist = SearchPlaylist
				btnFavList.Text = "📚 Favorites List"
				IsMusicSearching = false
				mSearchBtn.Text = "Search"
				if TriggerNotification then TriggerNotification("Loaded " .. #MusicPlaylist .. " tracks", true) end
				playTrackByIndex(1)
			else
				SearchPlaylist = {{id = 0, title = keyword .. " (No result)", artist = "Flash Center", isVip = false, url = "rbxassetid://1843420489"}}
				ShowingFavorites = false
				MusicPlaylist = SearchPlaylist
				btnFavList.Text = "📚 Favorites List"
				IsMusicSearching = false
				mSearchBtn.Text = "Search"
				if TriggerNotification then TriggerNotification("Network issue, loading fallback", false) end
				playTrackByIndex(1)
			end
		end)()
	end

